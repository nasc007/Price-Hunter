Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.env|^\.gitignore|composer\.(json|lock)$)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
