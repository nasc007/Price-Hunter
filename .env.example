APP_NAME="Price Hunter"
APP_ENV=local
APP_URL=http://127.0.0.1:8090
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=price_hunter
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Amazon Creators API: use only credentials issued to an approved Associates account.
# Apply at https://affiliate-program.amazon.com/ and manage API access in Associates Central.
# The Partner Tag is the tracking ID shown in Associates Central.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_ASSOCIATES_PARTNER_TAG=

# Optional local JSON file containing offers from a source you are authorized to use.
# Leave blank to keep this driver disabled. See the Phase 4 section in README.md.
AUTHORIZED_JSON_FEED_PATH=
AUTHORIZED_JSON_FEED_CODE=feed_autorizado
AUTHORIZED_JSON_FEED_NAME=Feed autorizado
